{
  "extends": "@repo/typescript-config/vue-app.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./src/types/*"],
      "@shared/*": ["../../shared/*"],
      "@editor/*": ["../../packages/editor/src/*"],
    }
  },
  "include": [
    "vite.config.ts",
    "src/types/**/*.d.ts",
    "types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
}

